# The dependency layer: operating system packages and Python libraries.
#
# Built only when requirements.txt changes, and tagged with a hash of that
# file, so an application-only deploy reuses it rather than reinstalling the
# libraries to change a template. The pattern (and the reasoning) is the
# sources directory's Dockerfile.base.
#
#   docker build -f Dockerfile.base -t .../datadesk-base:<hash> .
#
# Multi-stage on purpose. Docker layers are additive: installing
# build-essential in one layer and purging it in a later one leaves the
# bytes in the image. Only the finished site-packages crosses into the
# runtime stage.
#
# python:3.11 matches CI (.github/workflows/ci.yml) — the two must move
# together.

FROM python:3.11-slim AS builder

ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 PIP_NO_CACHE_DIR=1

# git is here because the Source Directory installs from a git tag and
# python:slim carries no git. Builder stage only: the runtime image copies
# /install and never sees it.
RUN apt-get update \
 && apt-get install -y --no-install-recommends build-essential libpq-dev git \
 && rm -rf /var/lib/apt/lists/*

COPY requirements.txt .
RUN pip install --prefix=/install -r requirements.txt

# The Source Directory, resolved to a released tag by the deploy rather
# than written into requirements.txt.
#
# A pinned line in git meant a pull request every time that package
# released, and a pull request this repository's ruleset requires somebody
# to approve -- which is the manual step moved, not removed. The deploy
# reads the newest tag instead.
#
# Still a tag, never a branch: a release happens because somebody bumped
# the version in that repository's own reviewed pull request, so an
# unfinished main cannot walk into this image. And the built image records
# exactly which tag, while the deploy references the image by digest, so
# what runs is reproducible even though the resolution is not pinned here.
#
# lnic-contracts is NOT installed here. It was, from an ARG defaulting to
# v0.1.0, while requirements.txt pinned it too -- two pins for one
# package, in two files, and this one ran second. Bumping the pin in
# requirements.txt changed the base image's hash, so the base rebuilt,
# installed v0.2.0, and then overwrote it with v0.1.0 from the default
# ARG. The image reported version 0.2.0 and carried v0.1.0's code, and
# /review/queue/ raised AttributeError on submit for a function that was
# in the version the metadata claimed.
#
# One pin, in requirements.txt, where every other dependency is.

ARG DIRECTORY_VERSION
RUN test -n "$DIRECTORY_VERSION" \
 && pip install --prefix=/install \
      "news-source-directory @ git+https://github.com/LocalNewsImpact/NewsSourceDirectory@${DIRECTORY_VERSION}"


FROM python:3.11-slim AS base

ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 PIP_NO_CACHE_DIR=1

# libpq at runtime only; the compiler never reaches this stage.
RUN apt-get update \
 && apt-get install -y --no-install-recommends libpq5 \
 && rm -rf /var/lib/apt/lists/*

COPY --from=builder /install /usr/local

RUN useradd --create-home --uid 1000 app
WORKDIR /app
