.venv/
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
db.sqlite3
staticfiles/
.env
.DS_Store
crawler.sqlite3
.mypy_cache/
.playwright-mcp/
# Screenshots taken while checking a rendering. `.playwright-mcp/` covers
# the ones written there; a capture with no path lands at the root, where
# `git add -A` sweeps it into the next commit. Seven had accumulated that
# way, none referenced by anything, 856KB in a repository that goes public.
/*.png

# Source documents are read, kept and consulted locally. They are other
# people's data — the Missouri Press directory is republished by nobody
# but MPA — so the repository holds the convention and the command that
# fetches them, never the readings themselves.
data/sources/*
!data/sources/README.md

# What make test writes; the floor reads coverage.xml and nothing keeps it.
.coverage
coverage.xml
htmlcov/

# Pre-push hook output. Local run logs: 23 were committed by accident
# before this rule existed, and every push since has offered more.
logs/pre-push/

# The historical CIN coding cohorts, aggregated by
# scripts/aggregate_coding_cohorts.py. The labels are ours; the article
# text in them is ~1,000 stories from Missouri publishers, and that is
# not this repository's to redistribute. Regenerate from the JotForm
# exports rather than committing the output.
data/coding/
