# Copy to .env and adjust. `make setup` does this when .env is missing.
# Never commit .env.

DJANGO_SECRET_KEY=dev-only-not-a-real-secret
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Google sign-in. Leave blank locally: with no client id the provider is
# unconfigured, the landing page says so, and superusers use the admin
# login — no OAuth credentials needed to run the project.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
# Comma-separated hosted domains allowed to sign in; empty = unrestricted
# (development only).
ALLOWED_AUTH_DOMAINS=localnewsimpact.org
